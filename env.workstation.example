# ==== append to your .env ====================================
# (you already use these two in docker-compose.yml — keep your values)
DOCKER_FILES_BASE=./docker_files
VOL_BASE=./volumes

# ---- workstation ---------------------------------------------
PROJECTS_BASE=./projects
USER_UID=1000                 # match `id -u` on your host
USER_GID=1000                 # match `id -g` on your host
PHP_DEFAULT=8.3               # what plain `php` points to initially
PHP_VERSIONS=7.2 7.4 8.0 8.1 8.2 8.3 8.4

# port ranges published to your host — anything you serve on these
# inside the workstation is reachable at localhost:<port>
WS_PORTS_A=8000-8099
WS_PORTS_B=3000-3010
WS_PORTS_C=5173-5180

# ---- mysql-8 / mysql-5 / phpmyadmin ---------------------------
# (DB_MYSQL_USERNAME/PASSWORD/ROOT_PASSWORD already exist in your .env)
DB_MYSQL_DATABASE=app
# mysql-8 → localhost:3306   mysql-5 → localhost:3307
# phpMyAdmin → http://localhost:8880 (pick MySQL 8 or MySQL 5 at login)
