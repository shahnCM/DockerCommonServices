#!/usr/bin/env bash
# Forwarding shim — npm lives in the workstation container, not on this host.
# `dev run` is the exact-passthrough mode: stdin stays open, stdout and stderr stay
# separate and unmodified, no TTY is allocated when non-interactive (a TTY would turn
# every \n into \r\n), and this process exits with npm's own status.
# Delete this file if you ever install npm on the host and want that one instead.
exec "$(dirname "${BASH_SOURCE[0]}")/dev" run npm "$@"
