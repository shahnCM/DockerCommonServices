#!/usr/bin/env bash
# Forwarding shim — node lives in the workstation container, not on this host.
# `dev run` is the exact-passthrough mode: stdin stays open, stdout and stderr stay
# separate and unmodified, no TTY is allocated when non-interactive (a TTY would turn
# every \n into \r\n), and this process exits with node's own status.
# Delete this file if you ever install node on the host and want that one instead.
exec "$(dirname "${BASH_SOURCE[0]}")/dev" run node "$@"
