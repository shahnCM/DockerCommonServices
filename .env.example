NETWORK_NAME=common

RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit

REDIS_PASSWORD=dev_password

DB_MYSQL_USERNAME=dev_user
DB_MYSQL_PASSWORD=dev_password
DB_MYSQL_ROOT_PASSWORD=dev_root_password
DB_MYSQL_DATABASE=app

# name aligned with what the postgres fragments actually read
DB_POSTGRES_USERNAME=admin
DB_POSTGRES_PASSWORD=admin

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# only used if ?meilisearch.yml is enabled
MEILI_MASTER_KEY=dev_master_key_change_me

# ---- paths ----------------------------------------------------
DOCKER_FILES_BASE=./docker_files
VOL_BASE=./volumes
PROJECTS_BASE=${HOME}/dev/projects

# ---- workstation ----------------------------------------------
USER_UID=1000                 # match `id -u` on your host
USER_GID=1000                 # match `id -g` on your host
PHP_DEFAULT=8.3               # what plain `php` points to initially
PHP_VERSIONS=7.2 7.4 8.0 8.1 8.2 8.3 8.4

# port ranges published to your host — anything you serve on these
# inside the workstation is reachable at localhost:<port>
WS_PORTS_A=8000-8099
WS_PORTS_B=3000-3010
WS_PORTS_C=5173-5180

# ---- aws (local emulation) ------------------------------------
# Values are ignored by DynamoDB Local, but the SDK refuses to sign a
# request unless credentials are present — so these must be set to
# something. Leave them as-is unless you also talk to real AWS from the
# workstation, in which case use a named profile instead.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Consumed by services/workstation.yml. The SDK reads AWS_ENDPOINT_URL_<SERVICE>
# natively, so app code needs no local-vs-prod branching: set it here, and
# unset it in production to hit real AWS.
#   AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000
# Note the two addresses — dynamodb-local:8000 from inside the workstation,
# localhost:18000 from your host (NoSQL Workbench, dynamodb-admin, curl).

# ---- quick port map -------------------------------------------
# mysql-8 → :3306    mysql-5 → :3307    postgres-16 → :5433
# phpMyAdmin → :8880    redis-7 → :6379    redis-insight → :5540
# mailpit SMTP → :1025   mailpit UI → :8125   meilisearch → :7700
# dynamodb-local → :18000
