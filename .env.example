# ---- which services start with `dev up` / `docker compose up -d` -------------
# comma-separated names; one services/<name>.yml = one name.  See: dev list
# change anytime:  dev enable postgres-16   |   dev disable mysql-5
COMPOSE_PROFILES=workstation,mysql-8,redis-7,mailpit,dynamodb-local

# ---- where things live ---------------------------------------------------------
PROJECTS_BASE=./projects      # your code; mounted at /projects inside the workstation
USER_UID=1000                 # `dev setup` fills these from `id -u` / `id -g`
USER_GID=1000

# ---- network exposure ----------------------------------------------------------
# 127.0.0.1 → only this machine can reach the databases (safe on public wifi)
# 0.0.0.0   → phone / LAN can reach them too (mobile testing)
BIND_IP=127.0.0.1

# ---- workstation ---------------------------------------------------------------
PHP_DEFAULT=8.3               # what plain `php` points to initially (php-default <v> to change)
PHP_VERSIONS=7.2 7.4 8.0 8.1 8.2 8.3 8.4
# ports published from the workstation: serve on any of these (bind 0.0.0.0 inside)
WS_PORTS_A=8000-8099
WS_PORTS_B=3000-3010
WS_PORTS_C=5173-5180

# ---- android emulator (service `android-emulator`; Linux hosts with /dev/kvm) -------
# screen in the browser: http://localhost:6080 · inside the workstation: adb-emu
# screen profile: Nexus 5 (1080x1920, ≈ 4 GB host RAM) · Pixel 8 · Pixel 9 · Pixel C (tablet) · Samsung Galaxy S6…S10 (1440x3040, 6 GB + 5 cores)
ANDROID_EMULATOR_DEVICE=Nexus 5
# extra emulator flags (-cores N, -no-snapshot …); guest RAM is forced to 4 GB by this image
ANDROID_EMULATOR_ARGS=-no-boot-anim -no-audio

# ---- credentials (dev defaults) -------------------------------------------------
DB_MYSQL_USERNAME=dev_user            # mysql-8, mysql-5, mariadb-10
DB_MYSQL_PASSWORD=dev_password
DB_MYSQL_ROOT_PASSWORD=dev_root_password
DB_MYSQL_DATABASE=app

DB_POSTGRES_USERNAME=admin            # postgres-16, postgres-timescale-16
DB_POSTGRES_PASSWORD=admin

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit
MEILI_MASTER_KEY=dev_master_key_change_me
MSSQL_SA_PASSWORD=Password123456!
INFLUX_USERNAME=user
INFLUX_PASSWORD=passpass
INFLUX_ADMIN_TOKEN=randomTokenValue1234

# ---- aws (local emulation) ------------------------------------------------------
# DynamoDB Local ignores the values, but SDKs refuse to sign without them.
# The workstation gets AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000 preset,
# so app code needs no local-vs-prod branching. From the host use localhost:18000.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack needs an account token since 2026.03 (free Hobby plan): app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# ---- quick port map (host side) ------------------------------------------------
# mysql-8 3306 · mysql-5 3307 · mariadb-10 3308 · postgres-16 5433 · timescale 5432
# redis-7 6379 · redis-insight 5540 · mongodb 27017 · mongo-express 8181 · mailpit UI 8125 / SMTP 1025
# phpmyadmin 8880 · adminer 8321 · pgadmin 5050 · grafana 3300 · dynamodb 18000 · localstack 14566
# rabbitmq 5672 / UI 15672 · kafka 29092 · elasticsearch 9229 · kibana 5601 · meilisearch 7700
# android-emulator screen 6080 · adb 5555
